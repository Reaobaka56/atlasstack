{
  "name": "atlasstack",
  "displayName": "AtlasStack",
  "description": "Premium AI-powered code analysis and security scanning",
  "version": "1.0.0",
  "publisher": "atlasstack",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlasstack/atlasstack"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Machine Learning",
    "Linters"
  ],
  "keywords": [
    "code analysis",
    "security",
    "vulnerabilities",
    "ai",
    "static analysis"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atlasstack.analyzeFile",
        "title": "Analyze Current File",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.analyzeSelection",
        "title": "Analyze Selection",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.analyzeWorkspace",
        "title": "Analyze Workspace",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.openChat",
        "title": "AI Architect Chat",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.showResults",
        "title": "Show Analysis Results",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.configure",
        "title": "Configure",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.connect",
        "title": "Connect to Server",
        "category": "AtlasStack"
      },
      {
        "command": "atlasstack.disconnect",
        "title": "Disconnect",
        "category": "AtlasStack"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "atlasstack.analyzeSelection",
          "when": "editorHasSelection",
          "group": "atlasstack@1"
        },
        {
          "command": "atlasstack.analyzeFile",
          "group": "atlasstack@2"
        }
      ],
      "explorer/context": [
        {
          "command": "atlasstack.analyzeFile",
          "when": "explorerResourceIsFile",
          "group": "atlasstack@1"
        }
      ],
      "commandPalette": [
        {
          "command": "atlasstack.analyzeFile"
        },
        {
          "command": "atlasstack.analyzeSelection"
        },
        {
          "command": "atlasstack.analyzeWorkspace"
        },
        {
          "command": "atlasstack.showResults"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "atlasstackResults",
          "name": "AtlasStack Analysis",
          "when": "atlasstack:connected",
          "icon": "$(shield)"
        }
      ],
      "atlasstack": [
        {
          "id": "atlasstack.chat",
          "type": "webview",
          "name": "AI Architect",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "atlasstackResults",
          "type": "tree",
          "name": "Analysis Results",
          "icon": "$(list-unordered)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlasstack",
          "title": "AtlasStack",
          "icon": "$(shield)"
        }
      ]
    },
    "configuration": {
      "title": "AtlasStack",
      "properties": {
        "atlasstack.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "AtlasStack server URL"
        },
        "atlasstack.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authentication"
        },
        "atlasstack.enableRealTimeAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time analysis as you type"
        },
        "atlasstack.analysisDelay": {
          "type": "number",
          "default": 1000,
          "description": "Delay in ms before triggering analysis"
        },
        "atlasstack.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show visual decorations for findings"
        },
        "atlasstack.analysisTypes": {
          "type": "array",
          "default": [
            "security",
            "performance"
          ],
          "description": "Types of analysis to run",
          "items": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "quality",
              "taint"
            ]
          }
        },
        "atlasstack.severityThreshold": {
          "type": "string",
          "default": "low",
          "description": "Minimum severity level to report",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "atlasstack.useSSL": {
          "type": "boolean",
          "default": false,
          "description": "Use SSL/TLS for connection"
        }
      }
    },
    "colors": [
      {
        "id": "atlasstack.critical",
        "description": "Color for critical severity findings",
        "defaults": {
          "dark": "#FF0000",
          "light": "#FF0000",
          "highContrast": "#FF0000"
        }
      },
      {
        "id": "atlasstack.high",
        "description": "Color for high severity findings",
        "defaults": {
          "dark": "#FF6B6B",
          "light": "#CC0000",
          "highContrast": "#FF6B6B"
        }
      },
      {
        "id": "atlasstack.medium",
        "description": "Color for medium severity findings",
        "defaults": {
          "dark": "#FFA500",
          "light": "#CC8400",
          "highContrast": "#FFA500"
        }
      },
      {
        "id": "atlasstack.low",
        "description": "Color for low severity findings",
        "defaults": {
          "dark": "#FFD93D",
          "light": "#CCAE00",
          "highContrast": "#FFD93D"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "ws": "^8.16.0"
  }
}
