# ============================================================
# AtlasStack Environment Configuration
# Copy this file to .env and fill in real values before running
# ============================================================

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LITE_MODE=true         # Set to false for full Docker/K8s deployment

# ⚠️  SECURITY: Generate a real secret before deploying
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_python_secrets_token_hex_32
JWT_EXPIRATION_HOURS=24

# ──────────────────────────────────────────────────────────
# AI / LLM (required for real analysis — not mock mode)
# Get your token at https://huggingface.co/settings/tokens
# ──────────────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ──────────────────────────────────────────────────────────
# Database (only needed when LITE_MODE=false)
# ──────────────────────────────────────────────────────────
POSTGRES_USER=atlasstack
POSTGRES_PASSWORD=atlasstack_secret
POSTGRES_DB=atlasstack
DATABASE_URL=postgresql://atlasstack:atlasstack_secret@localhost:5432/atlasstack

# ──────────────────────────────────────────────────────────
# Redis (only needed when LITE_MODE=false)
# ──────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ──────────────────────────────────────────────────────────
# RabbitMQ (only needed when LITE_MODE=false)
# ──────────────────────────────────────────────────────────
RABBITMQ_USER=atlasstack
RABBITMQ_PASSWORD=rabbitmq_secret

# ──────────────────────────────────────────────────────────
# Neo4j graph DB (only needed when LITE_MODE=false)
# ──────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# ──────────────────────────────────────────────────────────
# Optional: GitHub/GitLab tokens for private repo access
# ──────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITLAB_TOKEN=

# ──────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ──────────────────────────────────────────────────────────
# Model settings
# ──────────────────────────────────────────────────────────
DEFAULT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
MAX_ANALYSIS_TIME=300
